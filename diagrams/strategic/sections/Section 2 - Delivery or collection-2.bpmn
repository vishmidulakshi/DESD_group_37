<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="aa92d9c" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_1dxl46l">
    <bpmn:participant id="Participant_1gkalh8" name="Bristol Food Network platform" processRef="Process_1p2ysv7" />
    <bpmn:participant id="Participant_0hbt8av" name="Producer" />
    <bpmn:messageFlow id="Flow_10rirle" name="Collection details" sourceRef="Activity_022x2xv" targetRef="Participant_0hbt8av" />
    <bpmn:messageFlow id="Flow_1mx0hxu" sourceRef="Participant_0hbt8av" targetRef="Event_0hrb92s" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1p2ysv7" name="Section 2 - Delivery or collection" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1wxkfvp">
      <bpmn:lane id="Lane_0562pxo" name="Customer">
        <bpmn:flowNodeRef>Activity_0g5ovtu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1dhau7x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1lep0r5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1wzn8jx" name="Platform (system)">
        <bpmn:flowNodeRef>Activity_022x2xv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_16ch9l4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_19dhqdl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1vryjpg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1rvl84w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_170uz8t</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0hrb92s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_049mrx0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Activity_022x2xv" name="Arrange collection from each producer">
      <bpmn:documentation>Platform contacts each producer to arrange collection. Collection must be at least 48 hours ahead (producer lead time).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="arrange-collection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i457bp</bpmn:incoming>
      <bpmn:outgoing>Flow_1gu685u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_0g5ovtu" name="Choose collection time slot (min. 48 hours ahead)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15itytw</bpmn:incoming>
      <bpmn:outgoing>Flow_1i457bp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1dhau7x" name="Delivery or collection?" default="Flow_15itytw">
      <bpmn:incoming>Flow_17nybfa</bpmn:incoming>
      <bpmn:outgoing>Flow_15itytw</bpmn:outgoing>
      <bpmn:outgoing>Flow_1gtj5ss</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_1lep0r5" name="Enter delivery address">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1gtj5ss</bpmn:incoming>
      <bpmn:outgoing>Flow_1nlswpm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Delivery option to be chosen">
      <bpmn:outgoing>Flow_17nybfa</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_16ch9l4" name="Delivery not arranged">
      <bpmn:incoming>Flow_0ttj2pf</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_19dhqdl" name="Notify customer delivery is not available">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-customer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02c40sh</bpmn:incoming>
      <bpmn:outgoing>Flow_0ttj2pf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1vryjpg" name="Arrange home delivery">
      <bpmn:documentation>Platform arranges home delivery to the customer's address. If delivery is not possible, the customer is notified.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="arrange-home-delivery" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nlswpm</bpmn:incoming>
      <bpmn:outgoing>Flow_0vrhf8x</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1rvl84w">
      <bpmn:incoming>Flow_0vrhf8x</bpmn:incoming>
      <bpmn:incoming>Flow_1ilkoai</bpmn:incoming>
      <bpmn:outgoing>Flow_05bzuex</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_170uz8t" name="Delivery or collection arranged">
      <bpmn:incoming>Flow_05bzuex</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_0hrb92s" name="Collection confirmed">
      <bpmn:incoming>Flow_1gu685u</bpmn:incoming>
      <bpmn:outgoing>Flow_1ilkoai</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_149igky" messageRef="Message_36gb7d8" />
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent id="Event_049mrx0" name="Delivery not available" attachedToRef="Activity_1vryjpg">
      <bpmn:outgoing>Flow_02c40sh</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0sggly3" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1i457bp" sourceRef="Activity_0g5ovtu" targetRef="Activity_022x2xv" />
    <bpmn:sequenceFlow id="Flow_1gu685u" sourceRef="Activity_022x2xv" targetRef="Event_0hrb92s" />
    <bpmn:sequenceFlow id="Flow_15itytw" name="Collection" sourceRef="Gateway_1dhau7x" targetRef="Activity_0g5ovtu" />
    <bpmn:sequenceFlow id="Flow_17nybfa" sourceRef="StartEvent_1" targetRef="Gateway_1dhau7x" />
    <bpmn:sequenceFlow id="Flow_1gtj5ss" name="Delivery" sourceRef="Gateway_1dhau7x" targetRef="Activity_1lep0r5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryOption = "delivery"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1nlswpm" sourceRef="Activity_1lep0r5" targetRef="Activity_1vryjpg" />
    <bpmn:sequenceFlow id="Flow_0ttj2pf" sourceRef="Activity_19dhqdl" targetRef="Event_16ch9l4" />
    <bpmn:sequenceFlow id="Flow_02c40sh" sourceRef="Event_049mrx0" targetRef="Activity_19dhqdl" />
    <bpmn:sequenceFlow id="Flow_0vrhf8x" name="" sourceRef="Activity_1vryjpg" targetRef="Gateway_1rvl84w" />
    <bpmn:sequenceFlow id="Flow_1ilkoai" sourceRef="Event_0hrb92s" targetRef="Gateway_1rvl84w" />
    <bpmn:sequenceFlow id="Flow_05bzuex" sourceRef="Gateway_1rvl84w" targetRef="Event_170uz8t" />
  </bpmn:process>
  <bpmn:message id="Message_36gb7d8" name="Collection confirmed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="==orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
