<?xml version="1.0" encoding="UTF-8"?>
<b:definitions xmlns:b="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_section_3_order_splitting_and_commissio" targetNamespace="https://example.org/bristol-food-network" exporter="Camunda Web Modeler" exporterVersion="aa92d9c" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <b:process id="Process_section_3_order_splitting_and_commissio" name="Section 3 - Order Splitting and Commission" isExecutable="false">
    <b:documentation>Proposed operational section. Input: customer-confirmed details. Handoff: marketplace order, producer-specific elements, amounts, commission and payment data.</b:documentation>
    <b:laneSet id="Lanes_Process_section_3_order_splitting_and_commissio">
      <b:lane id="S3P" name="Marketplace platform">
        <b:flowNodeRef>S3Start</b:flowNodeRef>
        <b:flowNodeRef>S3Create</b:flowNodeRef>
        <b:flowNodeRef>S3Split</b:flowNodeRef>
        <b:flowNodeRef>S3Amounts</b:flowNodeRef>
        <b:flowNodeRef>S3Commission</b:flowNodeRef>
        <b:flowNodeRef>S3PaymentData</b:flowNodeRef>
        <b:flowNodeRef>S3Handoff</b:flowNodeRef>
      </b:lane>
      <b:lane id="S3Producer" name="Producer">
        <b:flowNodeRef>S3Orders</b:flowNodeRef>
      </b:lane>
    </b:laneSet>
    <b:startEvent id="S3Start" name="Confirmed order details received" />
    <b:serviceTask id="S3Create" name="Create marketplace order" />
    <b:serviceTask id="S3Split" name="Split order by producer" />
    <b:serviceTask id="S3Amounts" name="Calculate amount attributable to each producer" />
    <b:serviceTask id="S3Commission" name="Calculate marketplace 5% commission" />
    <b:serviceTask id="S3PaymentData" name="Compile payment request and order summary" />
    <b:endEvent id="S3Handoff" name="Order and payment data ready" />
    <b:task id="S3Orders" name="Record producer-specific order elements" />
    <b:sequenceFlow id="s3a" sourceRef="S3Start" targetRef="S3Create" />
    <b:sequenceFlow id="s3b" sourceRef="S3Create" targetRef="S3Split" />
    <b:sequenceFlow id="s3c" sourceRef="S3Split" targetRef="S3Amounts" />
    <b:sequenceFlow id="s3d" sourceRef="S3Amounts" targetRef="S3Commission" />
    <b:sequenceFlow id="s3e" sourceRef="S3Commission" targetRef="S3PaymentData" />
    <b:sequenceFlow id="s3f" sourceRef="S3PaymentData" targetRef="S3Handoff" />
    <b:sequenceFlow id="s3g" sourceRef="S3Split" targetRef="S3Orders" />
  </b:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_section_3_order_splitting_and_commissio">
    <bpmndi:BPMNPlane id="Plane_Process_section_3_order_splitting_and_commissio" bpmnElement="Process_section_3_order_splitting_and_commissio">
